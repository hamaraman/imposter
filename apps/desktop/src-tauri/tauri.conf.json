{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyCAD",
  "version": "0.3.0",
  "identifier": "com.mycad.app",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "MyCAD", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["mycad"], "name": "MyCAD Design", "description": "MyCAD design file", "role": "Editor" }],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
